# ─────────────────────────────────────────
# MOBILE — EXPO / REACT NATIVE (scoped only)
# ─────────────────────────────────────────
# Nested repos / working dirs
digitalsafaris-mobile/.git/

# Mobile assets — exclude all generated/raster except the sources
digitalsafaris-mobile/assets/*.png
digitalsafaris-mobile/assets/*.jpg
digitalsafaris-mobile/assets/*.jpeg
digitalsafaris-mobile/assets/*.webp

# Keep source artwork — always tracked
!digitalsafaris-mobile/assets/logo.png
!digitalsafaris-mobile/assets/logo.svg
!digitalsafaris-mobile/assets/Splash-Proposed.jpg
!digitalsafaris-mobile/assets/Splash-Proposed.png

# Expo
digitalsafaris-mobile/.expo/
digitalsafaris-mobile/.expo-shared/
digitalsafaris-mobile/expo-env.d.ts
digitalsafaris-mobile/app-env.d.ts

# Expo prebuild / native folders
digitalsafaris-mobile/android/
digitalsafaris-mobile/ios/

# RN build artifacts
digitalsafaris-mobile/.metro-health-check*
digitalsafaris-mobile/*.mobileprovision
digitalsafaris-mobile/*.orig.*
digitalsafaris-mobile/.gradle/
digitalsafaris-mobile/*.apk
digitalsafaris-mobile/*.aab
digitalsafaris-mobile/*.hprof
digitalsafaris-mobile/DerivedData/
digitalsafaris-mobile/Pods/
digitalsafaris-mobile/*.xcworkspace/xcuserdata/
digitalsafaris-mobile/*.xcuserstate

# EAS
digitalsafaris-mobile/.eas/
digitalsafaris-mobile/eas-build-*.json

# Flipper / debugger
digitalsafaris-mobile/react-native.config.js.bak
digitalsafaris-mobile/.flipper/

# Mobile build output
digitalsafaris-mobile/dist/
digitalsafaris-mobile/web-build/